diff --git a/src/compat/generic.c b/src/compat/generic.c
new file mode 100644
index 0000000..048ffbf
--- /dev/null
+++ b/src/compat/generic.c
@@ -0,0 +1,502 @@
+// Portable implementations of the SSE2/SSSE3/SSE4.1 intrinsics that gopher64
+// uses, for architectures that have neither the x86_64 intrinsics nor NEON
+// (riscv64, loongarch64, ppc64le and ppc64).
+//
+// The emulator only needs 16-bit integer vector arithmetic plus a handful of
+// byte shuffles, so plain C is enough to make those ports work. Lanes are
+// addressed by their byte offset inside the 128-bit value, exactly like the
+// x86 intrinsics do, and multi-byte lanes are read and written little endian,
+// so the result does not depend on the byte order of the host.
+//
+// The value crosses the FFI boundary as a struct of two uint64_t. That is an
+// aggregate of two integer eightbytes on every ABI in question, which is the
+// least surprising thing to pass by value; vector types are not, and they are
+// also passed in vector registers on some of them.
+
+#include <stdint.h>
+#include <string.h>
+
+typedef struct {
+    uint64_t v[2];
+} g64_m128i;
+
+static inline uint16_t g64_rd16(const uint8_t *p) {
+    return (uint16_t)((uint16_t)p[0] | ((uint16_t)p[1] << 8));
+}
+
+static inline void g64_wr16(uint8_t *p, uint16_t v) {
+    p[0] = (uint8_t)v;
+    p[1] = (uint8_t)(v >> 8);
+}
+
+static inline uint32_t g64_rd32(const uint8_t *p) {
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) |
+           ((uint32_t)p[3] << 24);
+}
+
+static inline void g64_wr32(uint8_t *p, uint32_t v) {
+    p[0] = (uint8_t)v;
+    p[1] = (uint8_t)(v >> 8);
+    p[2] = (uint8_t)(v >> 16);
+    p[3] = (uint8_t)(v >> 24);
+}
+
+static inline uint64_t g64_rd64(const uint8_t *p) {
+    return (uint64_t)g64_rd32(p) | ((uint64_t)g64_rd32(p + 4) << 32);
+}
+
+static inline void g64_wr64(uint8_t *p, uint64_t v) {
+    g64_wr32(p, (uint32_t)v);
+    g64_wr32(p + 4, (uint32_t)(v >> 32));
+}
+
+static inline int16_t g64_rd16s(const uint8_t *p) {
+    return (int16_t)g64_rd16(p);
+}
+
+static inline void g64_wr16s(uint8_t *p, int16_t v) {
+    g64_wr16(p, (uint16_t)v);
+}
+
+static inline int32_t g64_rd32s(const uint8_t *p) {
+    return (int32_t)g64_rd32(p);
+}
+
+static inline void g64_wr32s(uint8_t *p, int32_t v) {
+    g64_wr32(p, (uint32_t)v);
+}
+
+static inline int16_t g64_sat16(int32_t v) {
+    if (v > INT16_MAX) {
+        return INT16_MAX;
+    }
+    if (v < INT16_MIN) {
+        return INT16_MIN;
+    }
+    return (int16_t)v;
+}
+
+static inline uint16_t g64_satu16(int32_t v) {
+    if (v > UINT16_MAX) {
+        return UINT16_MAX;
+    }
+    if (v < 0) {
+        return 0;
+    }
+    return (uint16_t)v;
+}
+
+static inline void g64_in(const g64_m128i *x, uint8_t *out) {
+    memcpy(out, x->v, 16);
+}
+
+static inline g64_m128i g64_out(const uint8_t *in) {
+    g64_m128i r;
+    memcpy(r.v, in, 16);
+    return r;
+}
+
+g64_m128i g64_mm_setzero_si128(void) {
+    g64_m128i r;
+    r.v[0] = 0;
+    r.v[1] = 0;
+    return r;
+}
+
+g64_m128i g64_mm_set1_epi8(int8_t a) {
+    uint8_t r[16];
+    memset(r, (uint8_t)a, sizeof(r));
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_set1_epi16(int16_t a) {
+    uint8_t r[16];
+    for (int i = 0; i < 8; i++) {
+        g64_wr16s(r + i * 2, a);
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_set1_epi32(int32_t a) {
+    uint8_t r[16];
+    for (int i = 0; i < 4; i++) {
+        g64_wr32s(r + i * 4, a);
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_set_epi8(int8_t e15, int8_t e14, int8_t e13, int8_t e12, int8_t e11,
+                          int8_t e10, int8_t e9, int8_t e8, int8_t e7, int8_t e6,
+                          int8_t e5, int8_t e4, int8_t e3, int8_t e2, int8_t e1,
+                          int8_t e0) {
+    const uint8_t r[16] = {(uint8_t)e0,  (uint8_t)e1,  (uint8_t)e2,  (uint8_t)e3,
+                           (uint8_t)e4,  (uint8_t)e5,  (uint8_t)e6,  (uint8_t)e7,
+                           (uint8_t)e8,  (uint8_t)e9,  (uint8_t)e10, (uint8_t)e11,
+                           (uint8_t)e12, (uint8_t)e13, (uint8_t)e14, (uint8_t)e15};
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_set_epi16(int16_t e7, int16_t e6, int16_t e5, int16_t e4, int16_t e3,
+                           int16_t e2, int16_t e1, int16_t e0) {
+    uint8_t r[16];
+    g64_wr16s(r + 0, e0);
+    g64_wr16s(r + 2, e1);
+    g64_wr16s(r + 4, e2);
+    g64_wr16s(r + 6, e3);
+    g64_wr16s(r + 8, e4);
+    g64_wr16s(r + 10, e5);
+    g64_wr16s(r + 12, e6);
+    g64_wr16s(r + 14, e7);
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_add_epi16(g64_m128i a, g64_m128i b) {
+    uint8_t av[16], bv[16], r[16];
+    g64_in(&a, av);
+    g64_in(&b, bv);
+    for (int i = 0; i < 16; i += 2) {
+        g64_wr16(r + i, (uint16_t)(g64_rd16(av + i) + g64_rd16(bv + i)));
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_sub_epi16(g64_m128i a, g64_m128i b) {
+    uint8_t av[16], bv[16], r[16];
+    g64_in(&a, av);
+    g64_in(&b, bv);
+    for (int i = 0; i < 16; i += 2) {
+        g64_wr16(r + i, (uint16_t)(g64_rd16(av + i) - g64_rd16(bv + i)));
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_adds_epi16(g64_m128i a, g64_m128i b) {
+    uint8_t av[16], bv[16], r[16];
+    g64_in(&a, av);
+    g64_in(&b, bv);
+    for (int i = 0; i < 16; i += 2) {
+        g64_wr16s(r + i, g64_sat16((int32_t)g64_rd16s(av + i) + g64_rd16s(bv + i)));
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_adds_epu16(g64_m128i a, g64_m128i b) {
+    uint8_t av[16], bv[16], r[16];
+    g64_in(&a, av);
+    g64_in(&b, bv);
+    for (int i = 0; i < 16; i += 2) {
+        g64_wr16(r + i, g64_satu16((int32_t)g64_rd16(av + i) + g64_rd16(bv + i)));
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_subs_epi16(g64_m128i a, g64_m128i b) {
+    uint8_t av[16], bv[16], r[16];
+    g64_in(&a, av);
+    g64_in(&b, bv);
+    for (int i = 0; i < 16; i += 2) {
+        g64_wr16s(r + i, g64_sat16((int32_t)g64_rd16s(av + i) - g64_rd16s(bv + i)));
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_subs_epu16(g64_m128i a, g64_m128i b) {
+    uint8_t av[16], bv[16], r[16];
+    g64_in(&a, av);
+    g64_in(&b, bv);
+    for (int i = 0; i < 16; i += 2) {
+        g64_wr16(r + i, g64_satu16((int32_t)g64_rd16(av + i) - g64_rd16(bv + i)));
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_mullo_epi16(g64_m128i a, g64_m128i b) {
+    uint8_t av[16], bv[16], r[16];
+    g64_in(&a, av);
+    g64_in(&b, bv);
+    for (int i = 0; i < 16; i += 2) {
+        g64_wr16(r + i, (uint16_t)((uint32_t)g64_rd16(av + i) * g64_rd16(bv + i)));
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_mulhi_epi16(g64_m128i a, g64_m128i b) {
+    uint8_t av[16], bv[16], r[16];
+    g64_in(&a, av);
+    g64_in(&b, bv);
+    for (int i = 0; i < 16; i += 2) {
+        int32_t product = (int32_t)g64_rd16s(av + i) * g64_rd16s(bv + i);
+        g64_wr16(r + i, (uint16_t)((uint32_t)product >> 16));
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_mulhi_epu16(g64_m128i a, g64_m128i b) {
+    uint8_t av[16], bv[16], r[16];
+    g64_in(&a, av);
+    g64_in(&b, bv);
+    for (int i = 0; i < 16; i += 2) {
+        uint32_t product = (uint32_t)g64_rd16(av + i) * g64_rd16(bv + i);
+        g64_wr16(r + i, (uint16_t)(product >> 16));
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_and_si128(g64_m128i a, g64_m128i b) {
+    g64_m128i r;
+    r.v[0] = a.v[0] & b.v[0];
+    r.v[1] = a.v[1] & b.v[1];
+    return r;
+}
+
+g64_m128i g64_mm_andnot_si128(g64_m128i a, g64_m128i b) {
+    g64_m128i r;
+    r.v[0] = ~a.v[0] & b.v[0];
+    r.v[1] = ~a.v[1] & b.v[1];
+    return r;
+}
+
+g64_m128i g64_mm_or_si128(g64_m128i a, g64_m128i b) {
+    g64_m128i r;
+    r.v[0] = a.v[0] | b.v[0];
+    r.v[1] = a.v[1] | b.v[1];
+    return r;
+}
+
+g64_m128i g64_mm_xor_si128(g64_m128i a, g64_m128i b) {
+    g64_m128i r;
+    r.v[0] = a.v[0] ^ b.v[0];
+    r.v[1] = a.v[1] ^ b.v[1];
+    return r;
+}
+
+g64_m128i g64_mm_cmpeq_epi8(g64_m128i a, g64_m128i b) {
+    uint8_t av[16], bv[16], r[16];
+    g64_in(&a, av);
+    g64_in(&b, bv);
+    for (int i = 0; i < 16; i++) {
+        r[i] = av[i] == bv[i] ? 0xFF : 0x00;
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_cmpeq_epi16(g64_m128i a, g64_m128i b) {
+    uint8_t av[16], bv[16], r[16];
+    g64_in(&a, av);
+    g64_in(&b, bv);
+    for (int i = 0; i < 16; i += 2) {
+        g64_wr16(r + i, g64_rd16(av + i) == g64_rd16(bv + i) ? 0xFFFF : 0x0000);
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_cmpgt_epi16(g64_m128i a, g64_m128i b) {
+    uint8_t av[16], bv[16], r[16];
+    g64_in(&a, av);
+    g64_in(&b, bv);
+    for (int i = 0; i < 16; i += 2) {
+        g64_wr16(r + i, g64_rd16s(av + i) > g64_rd16s(bv + i) ? 0xFFFF : 0x0000);
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_cmplt_epi16(g64_m128i a, g64_m128i b) {
+    return g64_mm_cmpgt_epi16(b, a);
+}
+
+g64_m128i g64_mm_min_epi16(g64_m128i a, g64_m128i b) {
+    uint8_t av[16], bv[16], r[16];
+    g64_in(&a, av);
+    g64_in(&b, bv);
+    for (int i = 0; i < 16; i += 2) {
+        int16_t x = g64_rd16s(av + i);
+        int16_t y = g64_rd16s(bv + i);
+        g64_wr16s(r + i, x < y ? x : y);
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_max_epi16(g64_m128i a, g64_m128i b) {
+    uint8_t av[16], bv[16], r[16];
+    g64_in(&a, av);
+    g64_in(&b, bv);
+    for (int i = 0; i < 16; i += 2) {
+        int16_t x = g64_rd16s(av + i);
+        int16_t y = g64_rd16s(bv + i);
+        g64_wr16s(r + i, x > y ? x : y);
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_unpacklo_epi16(g64_m128i a, g64_m128i b) {
+    uint8_t av[16], bv[16], r[16];
+    g64_in(&a, av);
+    g64_in(&b, bv);
+    for (int i = 0; i < 4; i++) {
+        g64_wr16(r + i * 4, g64_rd16(av + i * 2));
+        g64_wr16(r + i * 4 + 2, g64_rd16(bv + i * 2));
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_unpackhi_epi16(g64_m128i a, g64_m128i b) {
+    uint8_t av[16], bv[16], r[16];
+    g64_in(&a, av);
+    g64_in(&b, bv);
+    for (int i = 0; i < 4; i++) {
+        g64_wr16(r + i * 4, g64_rd16(av + 8 + i * 2));
+        g64_wr16(r + i * 4 + 2, g64_rd16(bv + 8 + i * 2));
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_packs_epi16(g64_m128i a, g64_m128i b) {
+    uint8_t av[16], bv[16], r[16];
+    g64_in(&a, av);
+    g64_in(&b, bv);
+    for (int i = 0; i < 8; i++) {
+        int16_t v = g64_rd16s(av + i * 2);
+        r[i] = (uint8_t)(v > INT8_MAX ? INT8_MAX : (v < INT8_MIN ? INT8_MIN : v));
+    }
+    for (int i = 0; i < 8; i++) {
+        int16_t v = g64_rd16s(bv + i * 2);
+        r[8 + i] = (uint8_t)(v > INT8_MAX ? INT8_MAX : (v < INT8_MIN ? INT8_MIN : v));
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_packs_epi32(g64_m128i a, g64_m128i b) {
+    uint8_t av[16], bv[16], r[16];
+    g64_in(&a, av);
+    g64_in(&b, bv);
+    for (int i = 0; i < 4; i++) {
+        g64_wr16s(r + i * 2, g64_sat16(g64_rd32s(av + i * 4)));
+    }
+    for (int i = 0; i < 4; i++) {
+        g64_wr16s(r + 8 + i * 2, g64_sat16(g64_rd32s(bv + i * 4)));
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_shuffle_epi8(g64_m128i a, g64_m128i mask) {
+    uint8_t av[16], mv[16], r[16];
+    g64_in(&a, av);
+    g64_in(&mask, mv);
+    for (int i = 0; i < 16; i++) {
+        r[i] = mv[i] & 0x80 ? 0x00 : av[mv[i] & 0x0F];
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_blendv_epi8(g64_m128i a, g64_m128i b, g64_m128i mask) {
+    uint8_t av[16], bv[16], mv[16], r[16];
+    g64_in(&a, av);
+    g64_in(&b, bv);
+    g64_in(&mask, mv);
+    for (int i = 0; i < 16; i++) {
+        r[i] = mv[i] & 0x80 ? bv[i] : av[i];
+    }
+    return g64_out(r);
+}
+
+int32_t g64_mm_movemask_epi8(g64_m128i a) {
+    uint8_t av[16];
+    int32_t r = 0;
+    g64_in(&a, av);
+    for (int i = 0; i < 16; i++) {
+        r |= (int32_t)(av[i] >> 7) << i;
+    }
+    return r;
+}
+
+// The shifts take their count as an immediate in the x86 intrinsics. The
+// callers always pass a literal, but the C parameter is a plain int, so the
+// counts that x86 defines outside that range are handled here.
+
+g64_m128i g64_mm_srli_epi16(g64_m128i a, int imm8) {
+    uint8_t av[16], r[16];
+    g64_in(&a, av);
+    if (imm8 > 15) {
+        return g64_mm_setzero_si128();
+    }
+    for (int i = 0; i < 16; i += 2) {
+        g64_wr16(r + i, (uint16_t)(g64_rd16(av + i) >> imm8));
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_slli_epi16(g64_m128i a, int imm8) {
+    uint8_t av[16], r[16];
+    g64_in(&a, av);
+    if (imm8 > 15) {
+        return g64_mm_setzero_si128();
+    }
+    for (int i = 0; i < 16; i += 2) {
+        g64_wr16(r + i, (uint16_t)(g64_rd16(av + i) << imm8));
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_srai_epi16(g64_m128i a, int imm8) {
+    uint8_t av[16], r[16];
+    g64_in(&a, av);
+    if (imm8 > 15) {
+        imm8 = 15;
+    }
+    for (int i = 0; i < 16; i += 2) {
+        g64_wr16s(r + i, (int16_t)(g64_rd16s(av + i) >> imm8));
+    }
+    return g64_out(r);
+}
+
+g64_m128i g64_mm_insert_epi8(g64_m128i a, int32_t i, int imm8) {
+    uint8_t av[16];
+    g64_in(&a, av);
+    av[imm8 & 15] = (uint8_t)i;
+    return g64_out(av);
+}
+
+int32_t g64_mm_extract_epi8(g64_m128i a, int imm8) {
+    uint8_t av[16];
+    g64_in(&a, av);
+    return (int32_t)av[imm8 & 15];
+}
+
+g64_m128i g64_mm_insert_epi16(g64_m128i a, int32_t i, int imm8) {
+    uint8_t av[16];
+    g64_in(&a, av);
+    g64_wr16(av + (imm8 & 7) * 2, (uint16_t)i);
+    return g64_out(av);
+}
+
+int32_t g64_mm_extract_epi16(g64_m128i a, int imm8) {
+    uint8_t av[16];
+    g64_in(&a, av);
+    return (int32_t)g64_rd16(av + (imm8 & 7) * 2);
+}
+
+g64_m128i g64_mm_insert_epi32(g64_m128i a, int32_t i, int imm8) {
+    uint8_t av[16];
+    g64_in(&a, av);
+    g64_wr32s(av + (imm8 & 3) * 4, i);
+    return g64_out(av);
+}
+
+int32_t g64_mm_extract_epi32(g64_m128i a, int imm8) {
+    uint8_t av[16];
+    g64_in(&a, av);
+    return g64_rd32s(av + (imm8 & 3) * 4);
+}
+
+g64_m128i g64_mm_insert_epi64(g64_m128i a, int64_t i, int imm8) {
+    uint8_t av[16];
+    g64_in(&a, av);
+    g64_wr64(av + (imm8 & 1) * 8, (uint64_t)i);
+    return g64_out(av);
+}
+
+int64_t g64_mm_extract_epi64(g64_m128i a, int imm8) {
+    uint8_t av[16];
+    g64_in(&a, av);
+    return (int64_t)g64_rd64(av + (imm8 & 1) * 8);
+}
