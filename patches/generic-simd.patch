+++ b/src/compat/mod.rs
@@ -0,0 +1,14 @@
+// Per-architecture implementations of the vector intrinsics the emulation
+// cores use, for the architectures whose own intrinsics do not cover them.
+
+// x86_64 has the intrinsics, but seven of the ones the RSP cores call are
+// SSE4.1 rather than part of the baseline, so they are provided here with a run
+// time check.
+#[cfg(target_arch = "x86_64")]
+pub mod x86_64;
+
+// riscv64, loongarch64, ppc64le and ppc64 have neither the x86_64 intrinsics
+// nor NEON. src/compat/generic.c implements them in plain C, and generic.rs
+// declares the same functions.
+#[cfg(not(any(target_arch = "x86_64", target_arch = "aarch64")))]
+pub mod generic;
diff --git a/src/compat/x86_64.rs b/src/compat/x86_64.rs
new file mode 100644
index 0000000..7080761
--- /dev/null
+++ b/src/compat/x86_64.rs
@@ -0,0 +1,221 @@
+// A drop-in replacement for `use std::arch::x86_64::*` that also provides the
+// intrinsics the build's floor does not have.
+//
+// The floor is SSSE3, which Core 2 Duo has, so pshufb is available everywhere
+// and the re-export below is enough for it. Seven intrinsics the RSP cores call
+// are SSE4.1 instead: pblendvb, pinsrb, pextrb, pinsrd, pextrd, pinsrq and
+// pextrq. Each one here runs the real instruction when the CPU has SSE4.1 and
+// falls back to SSSE3 or plain lane access when it does not, so a Core 2 Duo
+// works and a Penryn or newer loses nothing.
+//
+// The definitions shadow the names re-exported from std, because an item in the
+// module takes precedence over one a glob brings in.
+
+pub use std::arch::x86_64::*;
+
+// is_x86_feature_detected caches its answer in an atomic, so the branch costs
+// about as much as the lane access it guards.
+
+#[inline]
+pub unsafe fn _mm_blendv_epi8(a: __m128i, b: __m128i, mask: __m128i) -> __m128i {
+    if std::arch::is_x86_feature_detected!("sse4.1") {
+        unsafe { blendv_epi8_sse41(a, b, mask) }
+    } else {
+        unsafe { blendv_epi8_ssse3(a, b, mask) }
+    }
+}
+
+#[target_feature(enable = "sse4.1")]
+unsafe fn blendv_epi8_sse41(a: __m128i, b: __m128i, mask: __m128i) -> __m128i {
+    std::arch::x86_64::_mm_blendv_epi8(a, b, mask)
+}
+
+unsafe fn blendv_epi8_ssse3(a: __m128i, b: __m128i, mask: __m128i) -> __m128i {
+    unsafe {
+        // the choice is made per byte from the high bit of the mask, so a
+        // signed compare against zero gives the 0xff or 0x00 selector
+        let select_b = _mm_cmpgt_epi8(_mm_setzero_si128(), mask);
+        _mm_or_si128(_mm_andnot_si128(select_b, a), _mm_and_si128(select_b, b))
+    }
+}
+
+#[inline]
+pub unsafe fn _mm_insert_epi8(a: __m128i, i: i32, imm8: i32) -> __m128i {
+    if std::arch::is_x86_feature_detected!("sse4.1") {
+        unsafe { insert_epi8_sse41(a, i, imm8) }
+    } else {
+        unsafe { insert_epi8_ssse3(a, i as u8, imm8) }
+    }
+}
+
+#[inline]
+pub unsafe fn _mm_extract_epi8(a: __m128i, imm8: i32) -> i32 {
+    if std::arch::is_x86_feature_detected!("sse4.1") {
+        unsafe { extract_epi8_sse41(a, imm8) }
+    } else {
+        unsafe { extract_epi8_ssse3(a, imm8) }
+    }
+}
+
+#[inline]
+pub unsafe fn _mm_insert_epi32(a: __m128i, i: i32, imm8: i32) -> __m128i {
+    if std::arch::is_x86_feature_detected!("sse4.1") {
+        unsafe { insert_epi32_sse41(a, i, imm8) }
+    } else {
+        unsafe { insert_epi32_ssse3(a, i, imm8) }
+    }
+}
+
+#[inline]
+pub unsafe fn _mm_extract_epi32(a: __m128i, imm8: i32) -> i32 {
+    if std::arch::is_x86_feature_detected!("sse4.1") {
+        unsafe { extract_epi32_sse41(a, imm8) }
+    } else {
+        unsafe { extract_epi32_ssse3(a, imm8) }
+    }
+}
+
+#[inline]
+pub unsafe fn _mm_insert_epi64(a: __m128i, i: i64, imm8: i32) -> __m128i {
+    if std::arch::is_x86_feature_detected!("sse4.1") {
+        unsafe { insert_epi64_sse41(a, i, imm8) }
+    } else {
+        unsafe { insert_epi64_ssse3(a, i, imm8) }
+    }
+}
+
+#[inline]
+pub unsafe fn _mm_extract_epi64(a: __m128i, imm8: i32) -> i64 {
+    if std::arch::is_x86_feature_detected!("sse4.1") {
+        unsafe { extract_epi64_sse41(a, imm8) }
+    } else {
+        unsafe { extract_epi64_ssse3(a, imm8) }
+    }
+}
+
+// The SSE4.1 versions take the lane as an immediate, hence the unrolled match.
+
+#[target_feature(enable = "sse4.1")]
+unsafe fn insert_epi8_sse41(a: __m128i, i: i32, imm8: i32) -> __m128i {
+    match imm8 & 15 {
+        0 => std::arch::x86_64::_mm_insert_epi8(a, i, 0),
+        1 => std::arch::x86_64::_mm_insert_epi8(a, i, 1),
+        2 => std::arch::x86_64::_mm_insert_epi8(a, i, 2),
+        3 => std::arch::x86_64::_mm_insert_epi8(a, i, 3),
+        4 => std::arch::x86_64::_mm_insert_epi8(a, i, 4),
+        5 => std::arch::x86_64::_mm_insert_epi8(a, i, 5),
+        6 => std::arch::x86_64::_mm_insert_epi8(a, i, 6),
+        7 => std::arch::x86_64::_mm_insert_epi8(a, i, 7),
+        8 => std::arch::x86_64::_mm_insert_epi8(a, i, 8),
+        9 => std::arch::x86_64::_mm_insert_epi8(a, i, 9),
+        10 => std::arch::x86_64::_mm_insert_epi8(a, i, 10),
+        11 => std::arch::x86_64::_mm_insert_epi8(a, i, 11),
+        12 => std::arch::x86_64::_mm_insert_epi8(a, i, 12),
+        13 => std::arch::x86_64::_mm_insert_epi8(a, i, 13),
+        14 => std::arch::x86_64::_mm_insert_epi8(a, i, 14),
+        _ => std::arch::x86_64::_mm_insert_epi8(a, i, 15),
+    }
+}
+
+unsafe fn insert_epi8_ssse3(a: __m128i, i: u8, imm8: i32) -> __m128i {
+    unsafe {
+        let mut lanes: [u8; 16] = std::mem::transmute(a);
+        lanes[(imm8 & 15) as usize] = i;
+        std::mem::transmute(lanes)
+    }
+}
+
+#[target_feature(enable = "sse4.1")]
+unsafe fn extract_epi8_sse41(a: __m128i, imm8: i32) -> i32 {
+    match imm8 & 15 {
+        0 => std::arch::x86_64::_mm_extract_epi8(a, 0),
+        1 => std::arch::x86_64::_mm_extract_epi8(a, 1),
+        2 => std::arch::x86_64::_mm_extract_epi8(a, 2),
+        3 => std::arch::x86_64::_mm_extract_epi8(a, 3),
+        4 => std::arch::x86_64::_mm_extract_epi8(a, 4),
+        5 => std::arch::x86_64::_mm_extract_epi8(a, 5),
+        6 => std::arch::x86_64::_mm_extract_epi8(a, 6),
+        7 => std::arch::x86_64::_mm_extract_epi8(a, 7),
+        8 => std::arch::x86_64::_mm_extract_epi8(a, 8),
+        9 => std::arch::x86_64::_mm_extract_epi8(a, 9),
+        10 => std::arch::x86_64::_mm_extract_epi8(a, 10),
+        11 => std::arch::x86_64::_mm_extract_epi8(a, 11),
+        12 => std::arch::x86_64::_mm_extract_epi8(a, 12),
+        13 => std::arch::x86_64::_mm_extract_epi8(a, 13),
+        14 => std::arch::x86_64::_mm_extract_epi8(a, 14),
+        _ => std::arch::x86_64::_mm_extract_epi8(a, 15),
+    }
+}
+
+unsafe fn extract_epi8_ssse3(a: __m128i, imm8: i32) -> i32 {
+    unsafe {
+        let lanes: [u8; 16] = std::mem::transmute(a);
+        lanes[(imm8 & 15) as usize] as i32
+    }
+}
+
+#[target_feature(enable = "sse4.1")]
+unsafe fn insert_epi32_sse41(a: __m128i, i: i32, imm8: i32) -> __m128i {
+    match imm8 & 3 {
+        0 => std::arch::x86_64::_mm_insert_epi32(a, i, 0),
+        1 => std::arch::x86_64::_mm_insert_epi32(a, i, 1),
+        2 => std::arch::x86_64::_mm_insert_epi32(a, i, 2),
+        _ => std::arch::x86_64::_mm_insert_epi32(a, i, 3),
+    }
+}
+
+unsafe fn insert_epi32_ssse3(a: __m128i, i: i32, imm8: i32) -> __m128i {
+    unsafe {
+        let mut lanes: [i32; 4] = std::mem::transmute(a);
+        lanes[(imm8 & 3) as usize] = i;
+        std::mem::transmute(lanes)
+    }
+}
+
+#[target_feature(enable = "sse4.1")]
+unsafe fn extract_epi32_sse41(a: __m128i, imm8: i32) -> i32 {
+    match imm8 & 3 {
+        0 => std::arch::x86_64::_mm_extract_epi32(a, 0),
+        1 => std::arch::x86_64::_mm_extract_epi32(a, 1),
+        2 => std::arch::x86_64::_mm_extract_epi32(a, 2),
+        _ => std::arch::x86_64::_mm_extract_epi32(a, 3),
+    }
+}
+
+unsafe fn extract_epi32_ssse3(a: __m128i, imm8: i32) -> i32 {
+    unsafe {
+        let lanes: [i32; 4] = std::mem::transmute(a);
+        lanes[(imm8 & 3) as usize]
+    }
+}
+
+#[target_feature(enable = "sse4.1")]
+unsafe fn insert_epi64_sse41(a: __m128i, i: i64, imm8: i32) -> __m128i {
+    match imm8 & 1 {
+        0 => std::arch::x86_64::_mm_insert_epi64(a, i, 0),
+        _ => std::arch::x86_64::_mm_insert_epi64(a, i, 1),
+    }
+}
+
+unsafe fn insert_epi64_ssse3(a: __m128i, i: i64, imm8: i32) -> __m128i {
+    unsafe {
+        let mut lanes: [i64; 2] = std::mem::transmute(a);
+        lanes[(imm8 & 1) as usize] = i;
+        std::mem::transmute(lanes)
+    }
+}
+
+#[target_feature(enable = "sse4.1")]
+unsafe fn extract_epi64_sse41(a: __m128i, imm8: i32) -> i64 {
+    match imm8 & 1 {
+        0 => std::arch::x86_64::_mm_extract_epi64(a, 0),
+        _ => std::arch::x86_64::_mm_extract_epi64(a, 1),
+    }
+}
+
+unsafe fn extract_epi64_ssse3(a: __m128i, imm8: i32) -> i64 {
+    unsafe {
+        let lanes: [i64; 2] = std::mem::transmute(a);
+        lanes[(imm8 & 1) as usize]
+    }
+}
